#include <bits/stdc++.h>
using namespace std;
void solve(){
    int n;
    cin>>n;
    vector<int>arr(n);
    for(int i=0;i<n;i++)cin>>arr[i];
    unordered_map<int,int>mp;
    for(auto &x:arr){
        int msb=31-__builtin_clz(x);
        mp[msb]++;
    }
    int mx=0;
    for(auto &[u,v]:mp)mx=max(mx,v);
    cout<<mx<<endl;
}
int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--)solve();

}
