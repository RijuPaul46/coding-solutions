#include <bits/stdc++.h>
using namespace std;
#define int long long
#define ll long long
signed main() {
	// your code goes here
	int n,k;
	cin>>n>>k;
	vector<int>arr(n);
	int mx=INT_MIN;
	int mn=INT_MAX;
	for(int i=0;i<n;i++){cin>>arr[i];
	    mx=max(mx,arr[i]);
	    mn=min(mn,arr[i]);
	}
	if(k>=mx){
	    cout<<"0"<<endl;
	}
	int mid=mn+(mx-mn)/2;
	 mx=INT_MIN;
	 mn=INT_MAX;
	for(auto &x:arr){
	    int p1=x+k;
	    int p2=max(0ll,x-k);
	    if(x>=mid){
	       //mx=max(mx,p1);
	       mx=max(mx,p2);
	       //mn=min(mn,p1);
	       mn=min(mn,p2);
	    }
	    
	   // mx=max(mx,x+k);
	   // mn=min(max(0,x-k),mn);
	}
	cout<<mx<<" "<<mn;
	int ans=INT_MAX;
	for(auto &x:arr){
	    int p1=x+k;
	    int p2=max(0ll,x-k);
	    if(x<mid){
	        if((p1>=mn && p1<=mx) || (p2>=mn && p2<=mx))
	        int d0=max(abs(mx-p1),abs(mx-p2));
	        int d1=max(abs(mn-p1),abs(mn-p2));
	        ans=min(ans,min(d0,d1));
	    }
	}
	cout<<ans;

}
