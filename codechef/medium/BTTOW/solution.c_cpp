#include <bits/stdc++.h>
using namespace std;
#define int long long
#define ll long long
signed main() {
	// your code goes here
	int n,k;
	cin>>n>>k;
	vector<int>arr(n);
	int mx=INT_MIN;
	int mn=INT_MAX;
	for(int i=0;i<n;i++){cin>>arr[i];
	    mx=max(mx,arr[i]);
	    mn=min(mn,arr[i]);
	}
	if(k>=mx){
	    cout<<"0"<<endl;
	}
	int mid=mn+(mx-mn)/2;
	 mx=INT_MIN;
	 mn=INT_MAX;
	for(auto &x:arr){
	    int p1=x+k;
	    int p2=max(0ll,x-k);
	    if(x>=mid){
	       //mx=max(mx,p1);
	       mx=max(mx,p2);
	       //mn=min(mn,p1);
	       mn=min(mn,p2);
	    }
	    
	   // mx=max(mx,x+k);
	   // mn=min(max(0,x-k),mn);
	}
// 	cout<<mx<<" "<<mn;
	int ans=mx-mn;
	for(auto &x:arr){
	    int p1=x+k;
	    int p2=max(0ll,x-k);
	    if(x<mid){
	        if((p1>=mn && p1<=mx) || (p2>=mn && p2<=mx)){
	            continue;
	        }
	        else{
	            int d0=INT_MAX,d1=INT_MAX,d2=INT_MAX,d3=INT_MAX;
	            if(p1<mn)d0=mx-p1;
	            if(p1>mx)d1=p1-mn;
	            if(p2>mx)d2=p2-mn;
	            if(p2<mn)d3=mx-p2;
	            int mni=min(min(d0,d1),min(d2,d3));
	            ans=mni;
	            if(d0==mni){
	                mn=p1;
	            }
	            if(d1==mni){
	                mx=p1;
	            }
	            if(d2==mni){
	                mx=p2;
	            }
	            if(d3==mni){
	                mn=p2;
	            }
	            
	        }
	        
	    }
	}
	cout<<ans;

}
