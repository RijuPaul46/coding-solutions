#include <bits/stdc++.h>
using namespace std;
#define int long long
int digitsum(int n){
    int sm=0;
    while(n>0){
        int d=n%10;
        sm+=d;
        n/=10;
    }
    return sm;
}
signed main() {
	// your code goes here
	 ios::sync_with_stdio(false);
    cin.tie(nullptr);
	int t;
	cin>>t;
	while(t--){
	    int a;
	    cin>>a;
	    
	    int sm=digitsum(a);
	    
	    if((sm%10) ==0){
	        cout<<"Valid"<<endl;
	    }
	    else cout<<"Invalid"<<endl;
	}

}
