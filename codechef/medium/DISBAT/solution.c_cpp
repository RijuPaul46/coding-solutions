#include <bits/stdc++.h>
using namespace std;
vector<int>par,rnk;
int findpar(int u){
    if(par[u]==u)return u;
    return par[u]=findpar(par[u]);
}
int unite(int u,int v){
    int pu=findpar(u);
    int pv=findpar(v);
    if(pu==pv)return 1;//both have same par
    if(rnk[pu]>rnk[pv]){
        par[pv]=pu;
        
    }
    else if(rnk[pu]<rnk[pv]){
        par[pu]=pv;
    }
    // else{
    //     // have same score
    //     return 1;
    // }
    return 0;
}
void solve(){
    int n;
    cin>>n;
    par.resize(n+1);
    rnk.resize(n+1);
    // vector<int>scr(n+1);
    // vector<int>owner(n+1);
    // unordered_map<
    //     int,
    //     set<pair<int,int>,greater<pair<int,int>>>> mp;
    for(int i=1;i<=n;i++){
        int x;
        cin>>x;
        rnk[i]=x;
        par[i]=i;
        // mp[i].insert({scr[i],i});
    }
    int q;
    cin>>q;
    for(int i=0;i<q;i++){
        int type;
        cin>>type;
        if(type==1){
            int x;
            cin>>x;
            int p=findpar(x);
            cout<<p<<endl;
        }
        else{
            int x,y;
            cin>>x>>y;
            int res=unite(x,y);
            if(res==1){
                cout<<"Invalid query!"<<endl;
            }
            

        }
    }
    
}
int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--)solve();
}
