#include <bits/stdc++.h>
using namespace std;
int dp[25];
int solve(int n){
    if(n==0)return 0;
    if(n==1)return 1;
    if(n==2)return 2;
    if(dp[n]!=-1)return dp[n];
    int one=solve(n-1);
    int two=solve(n-2);
    return dp[n]=(one+two);
}
int main() {
	// your code goes here
	int s;
	cin>>s;
	memset(dp,-1,sizeof(dp));
	cout<< solve(s)<<endl;
	return 0;

}
