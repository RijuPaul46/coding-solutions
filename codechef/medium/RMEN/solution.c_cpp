#include <bits/stdc++.h>
using namespace std;
char reverse(char c){
    if(c>='a' && c<='n'){
        int idx=c-'a';
        int ridx=13-idx;
        return (char)(ridx+'a');
    }
    int idx=c-'a';
    int ridx=25-idx+14;
    return (char)(ridx+'a');
}
int main() {
	// your code goes here
	string s;
	cin>>s;
	string t="";
	int n=s.size();
	for(int i=0;i<n;i++){
	    char c=s[i];
	    t+=reverse(c);
	    if(c>='a' && c<='n'){
	        
	    }
	    else i++;
	}
	cout<<t<<endl;

}
