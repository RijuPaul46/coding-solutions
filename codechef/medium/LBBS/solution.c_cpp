#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	string s;
	int k;
	cin>>s>>k;
	int n=s.size();
	int mx=0;
	for(int i=0;i<n;i++){
	    int one=0,zero=0;
	    for(int j=i;j<n;j++){
	       if(s[j]=='1')one++;
	       else zero++;
	       int diff=abs(one-zero);
	       if(diff%2==0){
	           if((diff/2) <=k){
	               mx=max(mx,j-i+1);
	           }
	       }
	    }
	}
	cout<<mx<<endl;
	return 0;

}
