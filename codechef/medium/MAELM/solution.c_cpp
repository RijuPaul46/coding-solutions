#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int n,m;
	cin>>n>>m;
	vector<vector<int>>a(n,vector<int>(n)),b(m,vector<int>(m));
	unordered_map<int,int>mp;
	for(int i=0;i<n;i++){
	    for(int j=0;j<n;j++){
	        cin>>a[i][j];
	        mp[a[i][j]]++;
	    }
	}
	bool flag=true;
	for(int i=0;i<m;i++){
	    for(auto &x:b[i]){
	        cin>>x;
	        if(mp.count(x)){
	            mp[x]--;
	        }
	        else{
	            flag=false;
	        }
	    }
	}
	if(!flag){
	    cout<<"FALSE"<<endl;
	    return 0;
	}
	for(auto &[u,v]:mp){
	    if(v<0){
	        cout<<"FALSE"<<endl;
	            return 0;
	    }
	}
	cout<<"TRUE"<<endl;
	return 0;

}
