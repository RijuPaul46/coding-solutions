#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int n,m;
	cin>>n>>m;
	vector<vector<int>>a(n,vector<int>(n)),b(m,vector<int>(m));
	unordered_map<int,int>mp;
	for(int i=0;i<n;i++){
	    for(auto &x:a[i])mp[x]++;
	}
	for(int i=0;i<m;i++){
	    for(auto &x:b[i]){
	        if(mp.count(x)){
	            mp[x]--;
	        }
	        else{
	            cout<<"FALSE"<<endl;
	            return 0;
	        }
	    }
	}
	for(auto &[u,v]:mp){
	    if(v<0){
	        cout<<"FALSE"<<endl;
	            return 0;
	    }
	}
	cout<<"TRUE"<<endl;
	return 0;

}
