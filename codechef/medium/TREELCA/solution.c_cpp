#include <bits/stdc++.h>
using namespace std;
int lca(int par,int node, vector<unordered_set<int>>&adj,int src,int dst){
    if(node==src || node==dst){
        return node;
    }
    int child=adj[node].size();
    vector<int>f(child,-1);
    int j=0;
    for(auto &ch:adj[node]){
        if(ch!=par){
            f[j++]=lca(node,ch,adj,src,dst);
        }
    }
    int pos=0;
    int a=-1;
    for(int i=0;i<child-1;i++){
        if(f[i]!=-1){a=f[i];pos++;}
    }
    if(pos>=2)return node;
    if(pos==1)return a;
    return -1;
}
int main() {
	// your code goes here
	int n,src,dst;
	cin>>n>>src>>dst;
	vector<unordered_set<int>>adj(n+1);
	for(int i=0;i<n-1;i++){
	    int u,v;
	    cin>>u>>v;
	    adj[u].insert(v);
	    adj[v].insert(u);
	}
	adj[1].insert(0);
	int lc=lca(0,1,adj,src,dst);
	cout<<lc<<endl;

}
