#include <bits/stdc++.h>
using namespace std;
void solve(){
    int n;
    cin>>n;
    vector<int>arr(n);
    int mn=INT_MAX;
    int sum=0;
    for(int i=0;i<n;i++){
        int&x=arr[i];
        cin>>x;
        mn=min(mn,x);
        sum+=x;
    }
    
    cout<<sum-mn<<endl;
    
}
int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--)solve();

}
